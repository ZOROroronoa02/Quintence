# ==============================================================================
# Quintence ~ Environment Variables Configuration
# ==============================================================================

# Application URL (used for canonical URLs, sitemaps, and Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://quintence.io

# Resend API Configuration (contact form delivery)
# Obtain an API key from https://resend.com/api-keys
# Testing without a verified domain: use the sandbox sender
#   CONTACT_FROM_EMAIL=onboarding@resend.dev
# and send only to the Resend account owner address.
# Production: verify a domain in Resend, then use e.g. inquiries@yourdomain.
# (Legacy — kept for reference. The contact form now sends via Gmail SMTP;
# see GMAIL_USER / GMAIL_APP_PASSWORD below.)
# RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Inbox that receives inquiry notifications (to) + verified sender (from)
# (Legacy Resend pair — same note as above.)
# CONTACT_TO_EMAIL=hello@quintence.io
# CONTACT_FROM_EMAIL=onboarding@resend.dev

# Gmail SMTP (contact form delivery — the live path)
# 1. Use any Gmail address that will send the mails.
# 2. Enable 2-Step Verification on that Google account, then create an
#    App Password: Google Account → Security → 2-Step Verification →
#    App passwords → name it e.g. "quintence-site" → copy the 16-letter code
#    (enter it WITHOUT spaces).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcdabcdabcdabcd

# Inbox that receives inquiry notification emails (can be the same Gmail).
CONTACT_TO_EMAIL=you@gmail.com

# Vercel Analytics (Automatically injected when deploying to Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
